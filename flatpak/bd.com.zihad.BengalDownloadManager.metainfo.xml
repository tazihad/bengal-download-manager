  <releases>
    <release version="0.3.2" date="2026-10-21">
      <description>
        <p>Bengal Download Manager 0.3.2 changes:</p>
        <ul>
          <li>Added autostart support for Flatpak via the XDG Desktop Background Portal</li>
          <li>Ensured automatic startup works seamlessly without extra sandbox permissions</li>
          <li>Updated application translations</li>
        </ul>
      </description>
    </release>
    <release version="0.3.1" date="2026-10-21">
        <description>
            <p>Bengal Download Manager 0.3.1 changes:</p>
