{
  "manifest_version": 3,
  "name": "Bengal DM Connector",
  "version": "1.0",
  "description": "Sends downloads directly to Bengal Download Manager.",
  "icons": {
    "48": "assets/icon-48.png"
  },
  "action": {
    "default_icon": {
      "48": "assets/icon-48.png"
    },
    "default_title": "Bengal DM",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}