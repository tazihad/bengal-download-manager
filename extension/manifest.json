{
  "manifest_version": 3,
  "name": "Bengal DM Integration Module",
  "version": "0.5.1",
  "description": "Integrates your browser with Bengal Download Manager for fast, multi-threaded downloads.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_title": "Bengal DM",
    "default_popup": "ui/popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "scripts": [
      "background/gdrive.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "notifications",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "options_ui": {
    "page": "ui/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject.js",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bengal-download-manager@zihad.com.bd",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
